# Remote Agent Approval Gateway — environment template.
# Copy to .env (never committed). Values MUST be empty here; real values are
# local-only secrets (security.md §4).

# Telegram (only remote UI, v1)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# HMAC key for callback-token verification — minimum: 32 characters from a
# real generator, e.g. `openssl rand -hex 32` (or base64url of 32 bytes).
# Startup refuses to serve approvals without it (fail closed); placeholder
# texts are rejected (security.md §4 / ADR-024).
APPROVAL_HMAC_KEY=

# Local gateway (loopback only — 127.0.0.1, localhost or ::1; any other bind
# address is a fatal configuration error, never silently accepted)
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=0
GATEWAY_TOKEN_FILE=

# Approval request TTL, seconds
APPROVAL_TTL_SECONDS=120

# Storage (SQLite path; created if the parent dir exists)
GATEWAY_DB_PATH=./data/gateway.db

# Relay (split deployments, architecture.md §10) — leave unset for topology A
RELAY_URL=
RELAY_GATEWAY_KEY=

# Logging
LOG_LEVEL=info
